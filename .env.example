# ===========================================
# Markato Docker Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ===========================================
# MongoDB Configuration (External - Coolify managed)
# ===========================================
# Use Coolify's MongoDB connection string or your own MongoDB instance
# Format: mongodb://username:password@host:port/database?authSource=admin
MONGODB_URI=mongodb://user:password@mongodb:27017/markato?authSource=admin

# ===========================================
# JWT Configuration
# ===========================================
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=your-jwt-secret-here-min-256-bits

# ===========================================
# Email Configuration (Resend)
# ===========================================
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_DOMAIN=your-domain.com
ADMIN_EMAIL=admin@your-domain.com

# ===========================================
# SMS Configuration (Twilio)
# ===========================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ===========================================
# Square Payment Configuration
# ===========================================
# Use sandbox credentials for development
SQUARE_ACCESS_TOKEN=your-square-access-token
SQUARE_LOCATION_ID=your-square-location-id

# ===========================================
# Google Maps Configuration
# ===========================================
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ===========================================
# Frontend URLs (for CORS)
# ===========================================
FRONTEND_URL=https://your-production-domain.com
FRONTEND_URL2=https://your-secondary-domain.com
FRONTEND_URL3=

# ===========================================
# Client Build Configuration
# ===========================================
VITE_API_URL=https://api.your-domain.com
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
VITE_SQUARE_APP_ID=your-square-app-id
VITE_SQUARE_LOCATION_ID=your-square-location-id

# ===========================================
# Security Configuration
# ===========================================
# Comma-separated list of trusted IPs (for rate limiting bypass)
TRUSTED_IPS=
